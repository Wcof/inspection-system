{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd '$PROJECT_ROOT' && npx vue-tsc --noEmit 2>&1 | head -20"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo '$FILE_PATH' | grep -qE 'mock/(initialData|migrations)\\.ts'; then echo '⚠️ 阻止修改核心数据文件，请通过 MockService 方法操作' >&2; exit 1; fi"
          }
        ]
      }
    ]
  }
}
